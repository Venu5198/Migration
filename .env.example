MIGRATION_ENV=development
MIGRATION_MONGODB_URI=
MIGRATION_UPLOAD_DIR=./data/uploads
MIGRATION_REPORT_DIR=./data/reports
MIGRATION_MAX_UPLOAD_BYTES=52428800
MIGRATION_ALLOW_XLSM=false
MIGRATION_CORS_ORIGINS=
MIGRATION_AUTH_REQUIRED=false
# Production requires non-empty comma-separated token:subject:role|role entries, injected by a secret manager.
MIGRATION_AUTH_TOKENS=
MIGRATION_MAX_JOB_ATTEMPTS=3
